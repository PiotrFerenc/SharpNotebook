{
  "name": "Catppuccin Mocha (SharpNotebook)",
  "type": "dark",
  "colors": {
    "editor.background": "#1e1e2e",
    "editor.foreground": "#cdd6f4",
    "editor.lineHighlightBackground": "#313244",
    "editorLineNumber.foreground": "#6c7086",
    "editorCursor.foreground": "#cba6f7",
    "editor.selectionBackground": "#585b70"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6c7086", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#a6e3a1" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#fab387" } },
    { "scope": ["constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#fab387" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#89dceb" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#f9e2af" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#89b4fa" } },
    { "scope": ["variable", "variable.other", "variable.parameter"], "settings": { "foreground": "#cdd6f4" } },
    { "scope": ["entity.name.variable.field", "variable.other.property"], "settings": { "foreground": "#f5c2e7" } },
    { "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#9399b2" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#cba6f7" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#f9e2af" } }
  ]
}
