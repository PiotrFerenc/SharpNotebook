<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SharpNotebook.Desktop.MainWindow"
        Title="SharpNotebook"
        Width="1300" Height="850"
        Background="{StaticResource CtpBaseBrush}"
        KeyDown="MainWindow_KeyDown">
    <Grid x:Name="RootGrid" ColumnDefinitions="240,*,240">
        <Border x:Name="LeftSidebar" Grid.Column="0" Background="{StaticResource CtpMantleBrush}"
                BorderBrush="{StaticResource CtpSurface0Brush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="EKSPLORATOR" FontWeight="Bold" FontSize="11"
                           Foreground="{StaticResource CtpOverlay0Brush}" Margin="4,0,0,10" />
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" Spacing="4">
                    <TextBox x:Name="NewNotebookNameBox" PlaceholderText="nazwa notebooka" />
                    <Button Content="＋" Click="NewNotebook_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Nowy notebook" />
                </StackPanel>
                <ListBox x:Name="FilesList" SelectionChanged="FilesList_SelectionChanged" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Column="1">
            <Border DockPanel.Dock="Top" Background="{StaticResource CtpMantleBrush}"
                    BorderBrush="{StaticResource CtpSurface0Brush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,8">
                    <Button Content="◧" Click="ToggleLeftSidebar_Click" ToolTip.Tip="Eksplorator (Ctrl+B)" />
                    <Button Content="◨" Click="ToggleRightSidebar_Click" ToolTip.Tip="Ulubione (Ctrl+Alt+B)" />
                    <Button Content="⊟" Click="CollapseAllToggle_Click" ToolTip.Tip="Zwiń/rozwiń wszystkie komórki i outputy (Ctrl+Alt+C)" />
                    <Button x:Name="ThemeToggleButton" Content="🌙" Click="ThemeToggle_Click" ToolTip.Tip="Motyw Dark/Light" />
                    <Button Content="Ω" Click="ToggleVariables_Click" ToolTip.Tip="Zmienne" />
                    <Button Content="📑" Click="ToggleOutline_Click" ToolTip.Tip="Spis treści (nagłówki markdown)" />
                    <Button Content="📦" Click="TogglePackages_Click" ToolTip.Tip="Paczki NuGet" />
                    <Button Content="🧾" Click="ExportCs_Click" ToolTip.Tip="Eksportuj kod (.cs)" />
                    <Button Content="🌐" Click="ExportHtml_Click" ToolTip.Tip="Eksportuj wynik (.html)" />
                    <Button Content="📓" Click="ExportIpynb_Click" ToolTip.Tip="Eksportuj do .ipynb (Jupyter)" />
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" x:Name="SidePanel" IsVisible="False"
                    Background="{StaticResource CtpMantleBrush}"
                    BorderBrush="{StaticResource CtpSurface0Brush}" BorderThickness="0,1,0,0"
                    Height="220">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                        <TextBlock x:Name="SidePanelTitle" FontWeight="Bold" Foreground="{StaticResource CtpMauveBrush}" />
                        <Button Content="🔄" Click="RefreshSidePanel_Click" Padding="6,2" ToolTip.Tip="Odśwież" />
                        <Button Content="✕" Click="CloseSidePanel_Click" Padding="6,2" ToolTip.Tip="Zamknij" />
                    </StackPanel>
                    <ListBox x:Name="SidePanelList" FontFamily="avares://SharpNotebook.Desktop/Assets/Fonts#JetBrains Mono,Consolas,monospace" FontSize="12" SelectionChanged="SidePanelList_SelectionChanged" />
                </DockPanel>
            </Border>

            <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged" />
        </DockPanel>

        <Border x:Name="RightSidebar" Grid.Column="2" Background="{StaticResource CtpMantleBrush}"
                BorderBrush="{StaticResource CtpSurface0Brush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="10">
                <TextBlock DockPanel.Dock="Top" Text="ULUBIONE" FontWeight="Bold" FontSize="11"
                           Foreground="{StaticResource CtpOverlay0Brush}" Margin="4,0,0,10" />
                <TextBlock DockPanel.Dock="Bottom" Text="☆ na komórce zapisuje ją tutaj jako szablon" FontSize="10"
                           Foreground="{StaticResource CtpOverlay0Brush}" TextWrapping="Wrap" Margin="4,10,4,0" />
                <ListBox x:Name="FavoritesList" />
            </DockPanel>
        </Border>

        <Border x:Name="SearchOverlay" Grid.Column="1" IsVisible="False"
                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,10,20,0"
                Background="{StaticResource CtpMantleBrush}" BorderBrush="{StaticResource CtpMauveBrush}" BorderThickness="1" Padding="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="SearchInput" Width="220" PlaceholderText="Szukaj w notebooku..."
                         TextChanged="SearchInput_TextChanged" KeyDown="SearchInput_KeyDown" />
                <TextBlock x:Name="SearchCount" VerticalAlignment="Center" Foreground="{StaticResource CtpOverlay0Brush}" FontSize="11" MinWidth="40" />
                <Button Content="↑" Click="SearchPrev_Click" Padding="6,2" ToolTip.Tip="Poprzednie (Shift+Enter)" />
                <Button Content="↓" Click="SearchNext_Click" Padding="6,2" ToolTip.Tip="Następne (Enter)" />
                <Button Content="✕" Click="CloseSearch_Click" Padding="6,2" ToolTip.Tip="Zamknij (Esc)" />
            </StackPanel>
        </Border>

        <Border x:Name="CommandPaletteOverlay" Grid.Column="0" Grid.ColumnSpan="3" IsVisible="False"
                Background="#AA000000">
            <Border Width="520" MaxHeight="420" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,90,0,0"
                    Background="{StaticResource CtpMantleBrush}" BorderBrush="{StaticResource CtpMauveBrush}" BorderThickness="1">
                <DockPanel Margin="10">
                    <TextBox x:Name="CommandPaletteInput" DockPanel.Dock="Top" PlaceholderText="Wpisz komendę..."
                             TextChanged="CommandPaletteInput_TextChanged" KeyDown="CommandPaletteInput_KeyDown" />
                    <ListBox x:Name="CommandPaletteList" Margin="0,8,0,0" MaxHeight="320" DoubleTapped="CommandPaletteList_DoubleTapped" />
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
