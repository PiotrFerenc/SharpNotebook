<svg viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="@Color" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ui-icon" aria-hidden="true">
    @((MarkupString)Body)
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 18;
    [Parameter] public string Color { get; set; } = "currentColor";

    private string Body => Bodies.GetValueOrDefault(Name, "");

    // Hand-authored line icons, one consistent 24x24 grid / stroke weight — no icon font, no emoji.
    private static readonly Dictionary<string, string> Bodies = new()
    {
        ["folder"] = """<path d="M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z"/>""",
        ["save"] = """<rect x="4" y="4" width="16" height="16" rx="2"/><rect x="7" y="4" width="8" height="5"/><rect x="8" y="14" width="4" height="4"/>""",
        ["play"] = """<polygon points="7,5 19,12 7,19"/>""",
        ["stop"] = """<rect x="6" y="6" width="12" height="12" rx="1"/>""",
        ["restart"] = """<path d="M4 12a8 8 0 1 1 2.5 5.8"/><polyline points="4 16 4 20 8 20"/>""",
        ["pencil"] = """<path d="M3 21l4-1 12-12-3-3L4 17l-1 4z"/><line x1="14" y1="7" x2="17" y2="10"/>""",
        ["trash"] = """<path d="M4 7h16"/><path d="M9 7V4h6v3"/><path d="M6 7l1 13h10l1-13"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>""",
        ["chevron-up"] = """<polyline points="6 15 12 9 18 15"/>""",
        ["chevron-down"] = """<polyline points="6 9 12 15 18 9"/>""",
        ["warning"] = """<path d="M12 3l10 18H2z"/><line x1="12" y1="9" x2="12" y2="14"/><circle cx="12" cy="17" r="0.9" fill="currentColor" stroke="none"/>""",
        ["bulb"] = """<path d="M9 18h6"/><path d="M9 21h6"/><path d="M12 3a6 6 0 0 0-3 11.2c.6.4 1 1.1 1 1.8h4c0-.7.4-1.4 1-1.8A6 6 0 0 0 12 3z"/>""",
        ["eye"] = """<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>""",
    };
}
